set -e
exec 1>&2

if [[ ! -f secrets/kopia.env ]] || ! grep -q '^KOPIA_PASSWORD=' secrets/kopia.env; then
    # Not configured yet: nothing runs
    exit 0
fi

systemctl --user daemon-reload
systemctl --user enable kopia-check.timer kopia-verify.timer
# restart, not try-restart: a stopped server must come back, apply-config waits for it
systemctl --user restart kopia.service kopia-server.service
# The server now runs the new image: the next configure-module must not restart it again
runagent kopia-server-fingerprint > .server-config
systemctl --user start kopia-check.timer kopia-verify.timer
runagent kopia-apply-config
