set -e
exec 1>&2

if ! grep -q '^TRAEFIK_HOST=' environment; then
    # Not configured yet: nothing runs
    exit 0
fi

systemctl --user daemon-reload
systemctl --user enable kopia-check.timer kopia-verify.timer
# A stopped server must come back too: apply-config waits for it
runagent kopia-restart-server --force
systemctl --user start kopia-check.timer kopia-verify.timer
runagent kopia-apply-config
