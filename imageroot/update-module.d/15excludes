# Earlier versions saved the built-in patterns too: keep only the admin ones, so a pattern
# dropped from DEFAULT_EXCLUDES in a later release does not stay as an admin pattern
import agent
import kopia_module as km

for key, value in km.settings_to_env({"excludes": km.read_settings()["excludes"]}).items():
    agent.set_env(key, value)
