# Weekly integrity check. Each run downloads about 10% of the blobs, so the whole repository
# is read again within a few months.

import json
import os
import sys
from datetime import datetime, timezone
import agent
import kopia_mail
import kopia_module as km

started = datetime.now(timezone.utc)
proc = km.kopia(["content", "verify", "--download-percent=10"], check=False, timeout=24 * 3600)
output = (proc.stdout + proc.stderr).strip()
result = {
    "started": started.isoformat(timespec="seconds"),
    "finished": datetime.now(timezone.utc).isoformat(timespec="seconds"),
    "ok": proc.returncode == 0,
    # The tail is enough to see what failed, the journal keeps the rest
    "details": "\n".join(output.splitlines()[-20:]),
}
print(output, file=sys.stderr)
with open("verify.json", "w") as f:
    json.dump(result, f, indent=2)

if not result["ok"]:
    settings = km.read_settings()
    if settings["admin_recipients"]:
        subject, body = kopia_mail.render("verify_failed", settings["alert_language"],
                                          host=os.environ.get("TRAEFIK_HOST", ""), details=result["details"])
        try:
            km.send_mail(agent.redis_connect(use_replica=True), settings["admin_recipients"], subject, body)
        except Exception as ex:
            print(agent.SD_WARNING + f"verify mail not sent: {ex}", file=sys.stderr)
    sys.exit(1)
