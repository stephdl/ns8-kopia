# Run by the core before the cluster backup, which reads state-exclude.conf right after.
# Maintenance rewrites indexes and deletes packs: while restic copies the repository, that leaves
# a copy that cannot open and files that vanish mid-read. With maintenance off, machines only add files.

import os
import subprocess
import sys
from datetime import datetime, timezone
import kopia_module as km

backup_repository = km.read_settings()["backup_repository"]
km.write_state_exclude(backup_repository)
if not backup_repository:
    print("Kopia repository left out of the backup", file=sys.stderr)

if subprocess.run(["systemctl", "--user", "-q", "is-active", "kopia-server.service"]).returncode != 0:
    # No server, no maintenance and no writes: the volume is already still, and the last policies dump stays
    if not backup_repository and not os.path.exists(km.POLICIES_DUMP):
        print("Kopia server stopped and no saved policies: a restore of this backup gives no folders",
              file=sys.stderr)
    sys.exit(0)
# Without the repository a restore needs them to give the machines their folders back
try:
    print(f"Saved {km.dump_policies()} Kopia policies", file=sys.stderr)
except Exception as ex:
    # Better a backup with the previous dump than no backup at all
    print(f"Kopia policies not saved, the previous copy stays: {ex}", file=sys.stderr)
if not backup_repository:
    sys.exit(0)
with open(km.MAINTENANCE_PAUSED, "w") as f:
    f.write(datetime.now(timezone.utc).isoformat(timespec="seconds"))
km.set_maintenance(False)
print("Kopia maintenance paused for the backup", file=sys.stderr)
