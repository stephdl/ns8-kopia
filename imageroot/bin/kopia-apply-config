# Push the module settings into Kopia: ACLs, global policy and machine accounts.
# Idempotent. It never deletes a machine account: only remove-client does that.

import sys
import agent
import kopia_module as km

# Each machine sees and manages only its own snapshots, reads its policies and cannot change
# its own account: the module state stays the only source of passwords.
ACLS = [
    ("type=content", "APPEND"),
    ("type=policy,policyType=global", "READ"),
    ("type=policy,policyType=host,hostname=OWN_HOST", "READ"),
    ("type=policy,username=OWN_USER,hostname=OWN_HOST", "READ"),
    ("type=snapshot,username=OWN_USER,hostname=OWN_HOST", "FULL"),
]


def target_dict(target):
    return dict(item.split("=", 1) for item in target.split(","))


def apply_acls():
    current = sorted((e["user"], sorted(e["target"].items()), e["access"]) for e in km.kopia_json(["server", "acl", "list"]) or [])
    wanted = sorted(("*@*", sorted(target_dict(t).items()), a) for t, a in ACLS)
    if current == wanted:
        return False
    print("Setting the module ACLs", file=sys.stderr)
    if current:
        km.kopia(["server", "acl", "delete", "--all", "--delete"])
    for target, access in ACLS:
        km.kopia(["server", "acl", "add", "--user=*@*", f"--target={target}", f"--access={access}"])
    return True


def apply_users():
    users = {u["username"]: u for u in km.kopia_json(["server", "user", "list"]) or []}
    hashes = km.load_client_hashes()
    changed = False
    for client in km.load_clients():
        name = client["name"]
        encoded = hashes.get(name)
        if not encoded:
            print(agent.SD_WARNING + f"no password stored for {name}, account skipped: reset its password", file=sys.stderr)
            continue
        if name in users and km.hash_matches(encoded, users[name]):
            continue
        verb = "set" if name in users else "add"
        print(f"Machine account {name}: {verb}", file=sys.stderr)
        # Same hash as before: the machine keeps working with the password in its keyring
        km.kopia(["server", "user", verb, name, f"--user-password-hash={encoded}"])
        changed = True
    return changed


if not km.wait_server():
    print(agent.SD_ERR + "Kopia server did not answer", file=sys.stderr)
    sys.exit(1)

changed = apply_acls()
current = km.kopia_json(["policy", "show", "--global"]) or {}
km.kopia(km.global_policy_args(current_ignore=current.get("files", {}).get("ignore", [])))
changed = apply_users() or changed
if changed:
    km.server_refresh()
