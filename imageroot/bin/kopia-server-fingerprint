# Print a hash of everything the server reads at start. 80start_services restarts it only when this changes.
( grep -E '^(TRAEFIK_HOST|CLIENT_PORT|KOPIA_IMAGE)=' environment; cat secrets/kopia.env certs/client.pem ) | sha256sum | cut -d' ' -f1
