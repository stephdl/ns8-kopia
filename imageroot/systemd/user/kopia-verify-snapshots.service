[Unit]
Description=Verify every snapshot after a restore
Requisite=kopia-server.service
After=kopia-server.service

[Service]
Type=oneshot
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
SyslogIdentifier=%N
ExecStart=runagent kopia-verify --snapshots
