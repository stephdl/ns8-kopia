{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "get-client-enrollment input",
    "$id": "http://schema.nethserver.org/kopia/get-client-enrollment-input.json",
    "description": "Return the enrollment scripts of a machine.",
    "examples": [{"name": "accounting@pc-accounting-01"}],
    "type": "object",
    "required": ["name"],
    "properties": {"name": {"type": "string", "pattern": "^[^@]+@[^@]+$", "description": "Machine identity, username@hostname."}}
}
