{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "remove-client input",
    "$id": "http://schema.nethserver.org/kopia/remove-client-input.json",
    "description": "Remove the Kopia account of a machine. Its snapshots stay in the repository.",
    "examples": [{"name": "accounting@pc-accounting-01"}],
    "type": "object",
    "required": ["name"],
    "properties": {"name": {"type": "string", "pattern": "^[^@]+@[^@]+$", "description": "Machine identity, username@hostname."}}
}
