{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "change-repository-password input",
    "$id": "http://schema.nethserver.org/kopia/change-repository-password-input.json",
    "description": "Change the password that encrypts the repository. The data key does not change, the old password stops working.",
    "examples": [{"repository_password": "New-written-down-2026"}],
    "type": "object",
    "required": ["repository_password"],
    "properties": {"repository_password": {"type": "string", "minLength": 12, "maxLength": 64}}
}
