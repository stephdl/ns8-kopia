import json
import os
import sys
import agent
import kopia_module as km

agent.set_weight(os.path.basename(__file__), 0)

password = json.load(sys.stdin)["repository_password"]
error = km.password_error(password)
if not error and password == km.read_env().get("KOPIA_PASSWORD"):
    error = "password_unchanged"
if error:
    agent.set_status("validation-failed")
    json.dump([{"field": "repository_password", "parameter": "repository_password", "value": "", "error": error}], fp=sys.stdout)
    sys.exit(2)
