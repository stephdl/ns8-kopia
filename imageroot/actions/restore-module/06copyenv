import json
import sys
import agent
import kopia_module as km

request = json.load(sys.stdin)
original = request["environment"]

for key in ["TRAEFIK_HOST", "TRAEFIK_LETS_ENCRYPT", "CLIENT_PORT"] + list(km.SETTINGS_DEFAULTS):
    if key in original:
        agent.set_env(key, original[key])
agent.dump_env()
