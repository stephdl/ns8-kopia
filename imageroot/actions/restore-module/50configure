# The core restored the repository volume before this step: configure-module connects it with the
# restored password, and the apply step creates the machine accounts again from their hashes.
# The client port stays the same so the machines reconnect unchanged. When another instance of
# this node holds it, nothing starts: remove that instance, then save the settings of this one.

import json
import os
import subprocess
import sys
import agent
import kopia_configure
import kopia_module as km

request = json.load(sys.stdin)
data = kopia_configure.request_from_env(request["environment"])
if not data["host"]:
    sys.exit(0)
owner = km.port_used_by_other_module(agent.redis_connect(), data["client_port"], os.environ["MODULE_ID"], os.environ["NODE_ID"])
if owner:
    print(agent.SD_WARNING + f"client port {data['client_port']} belongs to {owner} on this node: "
          f"remove {owner}, then save the settings of {os.environ['MODULE_ID']} to start it, and check the "
          f"snapshots: runagent -m {os.environ['MODULE_ID']} systemctl --user start kopia-verify-snapshots.service",
          file=sys.stderr)
    # The restored repository has its maintenance paused: an old pause makes kopia-check resume it once the server runs
    with open(km.MAINTENANCE_PAUSED, "w") as f:
        f.write("1970-01-01T00:00:00+00:00")
    sys.exit(0)
response = agent.tasks.run(agent_id=os.environ["AGENT_ID"], action="configure-module", data=data)
agent.assert_exp(response["exit_code"] == 0, "configure-module failed")
# The backup copied the repository with its maintenance paused
km.set_maintenance(True)
# Walk every snapshot now: a backup that failed to copy part of the data shows up before a user needs it
proc = subprocess.run(["systemctl", "--user", "start", "--no-block", "kopia-verify-snapshots.service"],
                      capture_output=True, text=True)
if proc.returncode != 0:
    print(agent.SD_WARNING + f"snapshot check not started: {proc.stderr.strip()}. "
          "Run it later: systemctl --user start kopia-verify-snapshots.service", file=sys.stderr)
