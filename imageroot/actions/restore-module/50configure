# The repository is not in the module backup: configure-module creates a new empty one with the
# restored password, and the apply step creates the machine accounts again from their hashes.
# The client port stays the same so the machines reconnect unchanged. When another instance of
# this node holds it, nothing starts: remove that instance, then save the settings of this one.

import json
import os
import sys
import agent
import kopia_configure
import kopia_module as km

request = json.load(sys.stdin)
data = kopia_configure.request_from_env(request["environment"])
if not data["host"]:
    sys.exit(0)
owner = km.port_used_by_other_module(agent.redis_connect(), data["client_port"], os.environ["MODULE_ID"], os.environ["NODE_ID"])
if owner:
    print(agent.SD_WARNING + f"client port {data['client_port']} belongs to {owner} on this node: "
          f"remove {owner}, then save the settings of {os.environ['MODULE_ID']} to start it", file=sys.stderr)
    sys.exit(0)
response = agent.tasks.run(agent_id=os.environ["AGENT_ID"], action="configure-module", data=data)
agent.assert_exp(response["exit_code"] == 0, "configure-module failed")
