# A new account with the name of a removed machine gets access to all its snapshots

import json
import sys
import agent
import kopia_module as km

name = json.load(sys.stdin)["name"]
if any(c["name"] == name for c in km.load_clients()):
    # Same answer add-client would give, before any warning about old snapshots
    agent.set_status("validation-failed")
    json.dump([{"field": "hostname", "parameter": "hostname", "value": name.split("@", 1)[1],
                "error": "client_exists"}], fp=sys.stdout)
    sys.exit(2)
times = sorted(snap["startTime"] for snap in km.machine_snapshots(name))
json.dump({"count": len(times), "first": times[0] if times else None, "last": times[-1] if times else None},
          fp=sys.stdout)
