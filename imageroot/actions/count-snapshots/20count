# A new account with the name of a removed machine gets access to all its snapshots

import json
import sys
import kopia_module as km

name = json.load(sys.stdin)["name"]
times = sorted(snap["startTime"] for snap in km.machine_snapshots(name))
json.dump({"count": len(times), "first": times[0] if times else None, "last": times[-1] if times else None},
          fp=sys.stdout)
