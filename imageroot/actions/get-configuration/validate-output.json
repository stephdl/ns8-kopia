{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "get-configuration output",
    "$id": "http://schema.nethserver.org/kopia/get-configuration-output.json",
    "description": "Kopia module settings. Passwords are never returned.",
    "type": "object",
    "required": ["host", "lets_encrypt", "client_port", "admin_password_set", "clients_count", "smarthost_enabled", "route_missing"],
    "properties": {
        "host": {"type": "string"},
        "lets_encrypt": {"type": "boolean"},
        "client_port": {"type": "integer"},
        "admin_password_set": {"type": "boolean"},
        "clients_count": {"type": "integer"},
        "smarthost_enabled": {"type": "boolean"},
        "default_sender": {"type": "string"},
        "route_missing": {"type": "boolean"},
        "excludes": {"type": "array", "items": {"type": "string"}},
        "admin_recipients": {"type": "array", "items": {"type": "string"}}
    }
}
