set -e
exec 1>&2

systemctl --user daemon-reload
systemctl --user enable kopia.service kopia-check.timer kopia-verify.timer
systemctl --user start kopia-check.timer kopia-verify.timer

# Restart only when something the server reads at start changed: a restart cuts the running backups
fingerprint=$(runagent kopia-server-fingerprint)
if [[ "$(cat .server-config 2>/dev/null)" != "${fingerprint}" ]] || ! systemctl --user -q is-active kopia-server.service; then
    systemctl --user restart kopia.service kopia-server.service
    echo "${fingerprint}" > .server-config
fi
