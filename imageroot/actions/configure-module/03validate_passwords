import json
import os
import sys
import agent
import kopia_module as km

agent.set_weight(os.path.basename(__file__), 0)

data = json.load(sys.stdin)
secrets = km.read_env()
errors = []
for field, env, rule in (("admin_password", "KOPIA_SERVER_PASSWORD", "admin_password_required"),
                         ("repository_password", "KOPIA_PASSWORD", "repository_password_required")):
    value = data.get(field, "")
    if not value:
        if not secrets.get(env):
            errors.append({"field": field, "parameter": field, "value": "", "error": rule})
        continue
    error = km.password_error(value)
    if error:
        errors.append({"field": field, "parameter": field, "value": "", "error": error})

# The repository password is changed with change-repository-password, which needs the old one
if (data.get("repository_password") and secrets.get("KOPIA_PASSWORD")
        and data["repository_password"] != secrets["KOPIA_PASSWORD"] and km.repository_exists()):
    errors.append({"field": "repository_password", "parameter": "repository_password", "value": "", "error": "repository_password_already_set"})

# A partial request is compared with the stored value of the other threshold
stored = km.read_settings()
owner_hours = data.get("owner_alert_hours", stored["owner_alert_hours"])
admin_hours = data.get("admin_alert_hours", stored["admin_alert_hours"])
if admin_hours <= owner_hours:
    errors.append({"field": "admin_alert_hours", "parameter": "admin_alert_hours", "value": admin_hours, "error": "admin_after_owner"})

if errors:
    agent.set_status("validation-failed")
    # Passwords are never echoed back
    json.dump(errors, fp=sys.stdout)
    sys.exit(4)
