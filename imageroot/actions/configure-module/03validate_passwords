import json
import os
import sys
import agent
import kopia_module as km

agent.set_weight(os.path.basename(__file__), 0)

data = km.configure_request()
secrets = km.read_env()
errors = []
if not data["host"]:
    errors.append({"field": "host", "parameter": "host", "value": "", "error": "host_required"})
password = data.get("admin_password", "")
if password:
    error = km.password_error(password)
    if error:
        errors.append({"field": "admin_password", "parameter": "admin_password", "value": "", "error": error})
elif not secrets.get("KOPIA_SERVER_PASSWORD"):
    errors.append({"field": "admin_password", "parameter": "admin_password", "value": "", "error": "admin_password_required"})

# A partial request is compared with the stored value of the other threshold
stored = km.read_settings()
owner_hours = data.get("owner_alert_hours", stored["owner_alert_hours"])
admin_hours = data.get("admin_alert_hours", stored["admin_alert_hours"])
if admin_hours <= owner_hours:
    errors.append({"field": "admin_alert_hours", "parameter": "admin_alert_hours", "value": admin_hours, "error": "admin_after_owner"})

if errors:
    agent.set_status("validation-failed")
    # Passwords are never echoed back
    json.dump(errors, fp=sys.stdout)
    sys.exit(4)
