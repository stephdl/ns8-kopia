# The policy and the snapshots both go: KopiaUI keeps scheduling a folder while one of them exists.
# To stop backups and keep the snapshots, disable-client-folder does it.

import json
import sys
import agent
import kopia_module as km

request = json.load(sys.stdin)
name = request["name"]
path = request["path"]
agent.assert_exp(any(c["name"] == name for c in km.load_clients()), "client not found")

snapshots = [s for s in km.machine_snapshots(name) if s["source"]["path"] == path]
has_policy = any(p["target"]["path"] == path for p in km.machine_policies(name))
if not snapshots and not has_policy:
    agent.set_status("validation-failed")
    json.dump([{"field": "path", "parameter": "path", "value": path, "error": "folder_not_found"}], fp=sys.stdout)
    sys.exit(2)

# The first colon splits identity and path, so Windows paths keep their drive letter
target = f"{name}:{path}"
if snapshots:
    km.kopia(["snapshot", "delete", "--delete"] + [s["id"] for s in snapshots], timeout=3600)
if has_policy:
    km.kopia(["policy", "delete", target])
print(f"Removed the folder {target} and its {len(snapshots)} snapshots", file=sys.stderr)
km.server_refresh()
