import json
import sys
from datetime import datetime, timezone
import agent
import kopia_enroll
import kopia_module as km

data = json.load(sys.stdin)
username = data["username"]
hostname = data["hostname"]
name = km.client_name(username, hostname)


def fail(field, error):
    agent.set_status("validation-failed")
    json.dump([{"field": field, "parameter": field, "value": data.get(field, ""), "error": error}], fp=sys.stdout)
    sys.exit(2)


for field in ("username", "hostname"):
    if not km.NAME_PATTERN.match(data[field]):
        fail(field, "name_format")
with km.clients_lock():
    clients = km.load_clients()
    if any(c["name"] == name for c in clients):
        fail("hostname", "client_exists")

    client = {"name": name, "username": username, "hostname": hostname,
              "owner_email": data.get("owner_email", ""),
              "created": datetime.now(timezone.utc).isoformat(timespec="seconds")}
    # Account first: if Kopia fails, nothing is stored and the admin can retry
    password = km.set_client_password(name)
    clients.append(client)
    km.save_clients(clients)
km.server_refresh()
# The core keeps task outputs about 8 hours, readable by cluster admins only. They can read the
# repository password anyway, which opens every backup.
json.dump(kopia_enroll.enrollment(client, password), fp=sys.stdout)
