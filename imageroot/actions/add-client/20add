import json
import sys
from datetime import datetime, timezone
import agent
import kopia_module as km

data = json.load(sys.stdin)
username = data["username"]
hostname = data["hostname"]
name = km.client_name(username, hostname)


def fail(field, error):
    agent.set_status("validation-failed")
    json.dump([{"field": field, "parameter": field, "value": data.get(field, ""), "error": error}], fp=sys.stdout)
    sys.exit(2)


for field in ("username", "hostname"):
    if not km.NAME_PATTERN.match(data[field]):
        fail(field, "name_format")
clients = km.load_clients()
if any(c["name"] == name for c in clients):
    fail("hostname", "client_exists")

password = km.generate_password()
secrets = km.load_client_secrets()
secrets[name] = password
km.save_client_secrets(secrets)
clients.append({"name": name, "username": username, "hostname": hostname,
                "owner_email": data.get("owner_email", ""),
                "created": datetime.now(timezone.utc).isoformat(timespec="seconds")})
km.save_clients(clients)

users = {u["username"] for u in km.kopia_json(["server", "user", "list"]) or []}
km.kopia(["server", "user", "set" if name in users else "add", name, f"--user-password-hash={km.hash_password(password)}"])
km.server_refresh()
json.dump({"name": name}, fp=sys.stdout)
