{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "reset-client-password input",
    "$id": "http://schema.nethserver.org/kopia/reset-client-password-input.json",
    "description": "Give a machine a new password. The machine must run its enrollment script again.",
    "examples": [{"name": "accounting@pc-accounting-01"}],
    "type": "object",
    "required": ["name"],
    "properties": {"name": {"type": "string", "pattern": "^[^@]+@[^@]+$", "description": "Machine identity, username@hostname."}}
}
