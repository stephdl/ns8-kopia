import json
import sys
import agent
import kopia_enroll
import kopia_module as km

request = json.load(sys.stdin)
name = request["name"]
# Before the reset: a bad key must not cost the machine its password
seal_key = kopia_enroll.load_public_key(request.get("public_key"))
# Checked inside the lock: a remove-client running at the same time cannot slip in between
with km.clients_lock():
    client = next((c for c in km.load_clients() if c["name"] == name), None)
    agent.assert_exp(client is not None, "client not found")
    password = km.set_client_password(name)
km.server_refresh()
# The core keeps task outputs about 8 hours: the UI sends a key so the password is not readable there
json.dump(kopia_enroll.seal(kopia_enroll.enrollment(client, password), seal_key), fp=sys.stdout)
