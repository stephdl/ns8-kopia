{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "list-client-folders input",
    "$id": "http://schema.nethserver.org/kopia/list-client-folders-input.json",
    "description": "List the folders of a machine: the ones with snapshots and the ones with a policy of their own.",
    "examples": [{"name": "accounting@pc-accounting-01"}],
    "type": "object",
    "required": ["name"],
    "properties": {"name": {"type": "string", "pattern": "^[^@]+@[^@]+$", "description": "Machine identity, username@hostname."}}
}
