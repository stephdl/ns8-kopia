# A folder of a machine exists once it has a snapshot or a policy: the admin creates the policy
# in the Kopia web UI, the machine itself cannot.

import json
import sys
import agent
import kopia_module as km

name = json.load(sys.stdin)["name"]
agent.assert_exp(any(c["name"] == name for c in km.load_clients()), "client not found")

folders = {}


def folder(path):
    return folders.setdefault(path, {"path": path, "policy": False, "disabled": False, "last_backup": None,
                                     "error_count": 0, "ignored_count": 0, "errors": []})


snapshots = km.machine_snapshots(name)
for path, snap in km.newest_snapshots(snapshots).items():
    entry = folder(path)
    entry["last_backup"] = km.parse_time(snap["endTime"]).isoformat()
    entry["error_count"], entry["ignored_count"], entry["errors"] = km.snapshot_errors(snap)
# A folder whose snapshots are all incomplete still shows up, never backed up
for snap in snapshots:
    folder(snap["source"]["path"])
for pol in km.machine_policies(name):
    if pol["target"]["path"]:
        entry = folder(pol["target"]["path"])
        entry["policy"] = True
        entry["disabled"] = km.folder_disabled(pol)

json.dump({"folders": sorted(folders.values(), key=lambda f: f["path"].lower())}, fp=sys.stdout)
