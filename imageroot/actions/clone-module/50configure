# A clone is a full copy: same host, same client port, same certificate, same machine accounts and
# a copy of the repository volume. On another node it starts at once. On the same node the source
# still holds the port and the route: the clone stays stopped. Remove the source, then save the
# settings of the clone to start it. The machines keep working without any change.

import os
import sys
import agent
import kopia_configure
import kopia_module as km

data = kopia_configure.request_from_env(os.environ)
if not data["host"]:
    sys.exit(0)

owner = km.port_used_by_other_module(agent.redis_connect(), data["client_port"], os.environ["MODULE_ID"], os.environ["NODE_ID"])
if owner:
    print(agent.SD_WARNING + f"client port {data['client_port']} belongs to {owner} on this node: "
          f"remove {owner}, then save the settings of {os.environ['MODULE_ID']} to start it", file=sys.stderr)
    # The core enables the units of the source at the end of the clone: keep the pod out of that
    # list, or it would fight the source for the port. configure-module enables it later.
    units = "default-target.clone-module"
    if os.path.exists(units):
        # One line of unit names separated by spaces, see the core transfer-state action
        with open(units) as f:
            kept = [u for u in f.read().split() if u not in ("kopia.service", "kopia-server.service")]
        with open(units, "w") as f:
            f.write(" ".join(kept) + "\n")
    sys.exit(0)

response = agent.tasks.run(agent_id=os.environ["AGENT_ID"], action="configure-module", data=data)
agent.assert_exp(response["exit_code"] == 0, "configure-module failed")
