import json
import os
import sys
import agent
import kopia_mail
import kopia_module as km

recipient = json.load(sys.stdin)["recipient"]
rdb = agent.redis_connect(use_replica=True)
settings = km.read_settings()
subject, body = kopia_mail.render("test", settings["alert_language"], host=os.environ.get("TRAEFIK_HOST", ""))
try:
    km.send_mail(rdb, [recipient], subject, body)
except Exception as ex:
    print(agent.SD_ERR + f"test mail failed: {ex}", file=sys.stderr)
    agent.set_status("validation-failed")
    json.dump([{"field": "recipient", "parameter": "recipient", "value": recipient, "error": "mail_failed"}], fp=sys.stdout)
    sys.exit(2)
