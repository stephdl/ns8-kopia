import json
import sys
import agent
import kopia_module as km

request = json.load(sys.stdin)
name = request["name"]
path = request["path"]
agent.assert_exp(any(c["name"] == name for c in km.load_clients()), "client not found")

if not any(p["target"]["path"] == path for p in km.machine_policies(name)):
    agent.set_status("validation-failed")
    json.dump([{"field": "path", "parameter": "path", "value": path, "error": "folder_not_found"}], fp=sys.stdout)
    sys.exit(2)

target = f"{name}:{path}"
# Kopia 0.23.1 has no flag to clear Manual Snapshots Only: any policy set without --manual does it
km.kopia(["policy", "set", target, "--run-missed=inherit"])
print(f"Enabled the backups of {target}", file=sys.stderr)
km.server_refresh()
