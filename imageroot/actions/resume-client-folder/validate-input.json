{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "resume-client-folder input",
    "$id": "http://schema.nethserver.org/kopia/resume-client-folder-input.json",
    "description": "Back up again a folder that remove-client-folder stopped.",
    "examples": [{"name": "accounting@pc-accounting-01", "path": "C:\\Users\\anna\\Documents"}],
    "type": "object",
    "required": ["name", "path"],
    "properties": {
        "name": {"type": "string", "pattern": "^[^@]+@[^@]+$", "description": "Machine identity, username@hostname."},
        "path": {"type": "string", "minLength": 1, "maxLength": 4096, "description": "Folder path as the machine reports it."}
    }
}
